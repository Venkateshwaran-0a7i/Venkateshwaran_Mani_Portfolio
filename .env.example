# Public site origin — no trailing slash. Used for metadataBase, OG, canonical, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://venkateshwaran-0a7i.github.io/Venkateshwaran_Mani_Portfolio

# Sub-path hosting (GitHub Pages project sites). Leave empty for root / custom domain.
# Example: /Venkateshwaran_Mani_Portfolio
NEXT_PUBLIC_BASE_PATH=

# Optional form backend (Formspree / Web3Forms / Getform). Leave empty to use mailto: fallback.
# Formspree example: https://formspree.io/f/xxxxxxxx
# Web3Forms example: https://api.web3forms.com/submit  (include access_key in the form)
NEXT_PUBLIC_FORM_ENDPOINT=

# Build mode: static | standalone | vercel  (default: static)
DEPLOY_TARGET=static
