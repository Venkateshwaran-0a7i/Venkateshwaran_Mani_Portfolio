# ── Site URL (no trailing slash) ─────────────────────────────────────────────
# Used for metadataBase, Open Graph, canonical, sitemap.xml, robots.txt.
# Vercel: set to your production URL, e.g. https://your-app.vercel.app
# GitHub Pages: https://venkateshwaran-0a7i.github.io/Venkateshwaran_Mani_Portfolio
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ── Sub-path hosting ─────────────────────────────────────────────────────────
# Leave EMPTY on Vercel / custom domain / root deploys.
# GitHub Pages project site only: /Venkateshwaran_Mani_Portfolio
NEXT_PUBLIC_BASE_PATH=

# ── Optional contact form backend ────────────────────────────────────────────
# Formspree / Web3Forms / Getform URL. Leave empty to use mailto: fallback.
# Formspree: https://formspree.io/f/xxxxxxxx
NEXT_PUBLIC_FORM_ENDPOINT=

# ── Build mode (optional — auto-detected on Vercel) ──────────────────────────
# static | standalone | vercel
# On Vercel, leave unset (or set vercel). Do NOT set static on Vercel.
# DEPLOY_TARGET=vercel
