{
  "name": "venkateshwaran-mani-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
  "node": "24.x"
},
  "scripts": {
    "prebuild": "node scripts/generate-seo.mjs",
    "dev": "next dev",
    "build": "next build",
    "build:static": "npm run seo && cross-env DEPLOY_TARGET=static next build",
    "build:standalone": "npm run seo && cross-env DEPLOY_TARGET=standalone next build",
    "build:vercel": "npm run seo && cross-env DEPLOY_TARGET=vercel next build",
    "start": "next start",
    "preview:static": "npx --yes serve out",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seo": "node scripts/generate-seo.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "lenis": "^1.3.26",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3"
  }
}
